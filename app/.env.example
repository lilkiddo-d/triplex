# Active chain: 4663 = Robinhood Chain mainnet, 31337 = local anvil fork ("Triplex Local Fork")
NEXT_PUBLIC_CHAIN_ID=4663
# RPC for chain 4663 (defaults to the public, rate-limited endpoint). Ignored for 31337 (uses http://127.0.0.1:8545).
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# WalletConnect Cloud project id. Empty = injected (browser extension) wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# $TRPX project token address. Empty = all token features (staking, fee discounts) hidden.
NEXT_PUBLIC_PROJECT_TOKEN=
# Comma-separated ISO 3166-1 alpha-2 country codes to block (Vercel geo header). Empty = geoblock off.
NEXT_PUBLIC_GEOBLOCK_COUNTRIES=
